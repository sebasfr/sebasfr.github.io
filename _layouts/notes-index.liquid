---
layout: default
---
{%- assign lang = page.lang | default: 'en' -%}
{%- assign t = site.data.i18n[lang] -%}
{%- assign courses = site.courses | where: 'lang', lang | where_exp: 'c', 'c.chapter == nil' | sort: 'code' -%}

<div class="post brutalist-page notes-page" lang="{{ t.html_lang }}">
  <header class="post-header page-head">
    <div class="drop-numeral anim-stamp" aria-hidden="true">{{ page.drop_numeral | default: 'IV' }}.</div>
    <div class="page-head-body">
      <div class="page-head-meta">
        <p class="page-head-supertitle anim-clip-reveal">{{ t.notes_supertitle }}</p>
        {% include lang_switch.liquid en_url="/notes/" es_url="/notes/es/" current=lang %}
      </div>
      <h1 class="page-head-title anim-letter-mask">{{ page.title | default: t.notes_title }}</h1>
      {% assign dek = page.description | default: t.notes_description %}
      {% if dek %}
        <p class="page-head-dek anim-fade-rise">{{ dek }}</p>
      {% endif %}
    </div>
  </header>

  <article class="brutalist-article notes-body anim-content-sweep">
    {% if courses.size == 0 %}
      <p class="mono">{{ t.notes_empty }}</p>
    {% else %}
      <ol class="notes-list course-index">
        {% for course in courses %}
          {%- assign chapter_count = site.courses | where: 'course', course.course | where: 'lang', lang | where_exp: 'c', 'c.chapter' | size -%}
          {%- if lang == 'es' -%}{%- assign native_lang = 'en' -%}{%- else -%}{%- assign native_lang = 'es' -%}{%- endif -%}
          <li class="notes-row course-index-row">
            <p class="notes-row-date mono">{{ course.code | default: course.course | upcase }}</p>
            <div class="notes-row-body">
              <h2 class="notes-row-title">
                <a class="u-underline" href="{{ course.url | relative_url }}">{{ course.title }}</a>
              </h2>
              {% if course.title_native %}
                <p class="notes-row-dek" lang="{{ native_lang }}">
                  <em>{{ course.title_native }}</em>
                </p>
              {% endif %}
              {% if course.description %}
                <p class="notes-row-dek">{{ course.description | markdownify | strip_html | strip }}</p>
              {% endif %}
              <p class="notes-row-meta mono">
                {{ chapter_count }}
                {%- if chapter_count == 1 %} {{ t.chapters_one }}{% else %} {{ t.chapters_other }}{% endif -%}
                {% if course.instructor %}
                  &middot; {{ course.instructor | upcase }}
                {% endif %}
              </p>
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endif %}
  </article>
</div>
