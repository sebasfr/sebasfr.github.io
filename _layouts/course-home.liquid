---
layout: default
---
{%- assign lang = page.lang | default: 'en' -%}
{%- assign t = site.data.i18n[lang] -%}
{%- assign chapters = site.courses | where: 'course', page.course | where: 'lang', lang | where_exp: 'c', 'c.chapter' | sort: 'chapter' -%}

<div class="post brutalist-page course-home" lang="{{ t.html_lang }}">
  <header class="post-header page-head">
    <div class="page-head-body">
      <div class="page-head-meta">
        <p class="page-head-supertitle anim-clip-reveal mono">
          IV &mdash; {{ t.notes_title | upcase }} &middot; {{ page.code | default: page.course | upcase }}
        </p>
        {% include lang_switch.liquid %}
      </div>
      <h1 class="page-head-title anim-letter-mask">{{ page.title }}</h1>
      {% if page.title_native %}
        {%- if lang == 'es' -%}{%- assign native_lang = 'en' -%}{%- else -%}{%- assign native_lang = 'es' -%}{%- endif -%}
        <p class="page-head-dek anim-fade-rise" lang="{{ native_lang }}">
          <em>{{ page.title_native }}</em>
        </p>
      {% endif %}
    </div>
  </header>

  <article class="brutalist-article anim-content-sweep">
    <dl class="course-meta mono">
      {% if page.instructor %}
        <div class="course-meta-row">
          <dt>{{ t.instructor }}</dt>
          <dd>{{ page.instructor }}</dd>
        </div>
      {% endif %}
      {% if page.institution %}
        <div class="course-meta-row">
          <dt>{{ t.institution }}</dt>
          <dd>{{ page.institution }}</dd>
        </div>
      {% endif %}
      <div class="course-meta-row">
        <dt>{{ t.language }}</dt>
        <dd>{{ t.name }}</dd>
      </div>
      <div class="course-meta-row">
        <dt>{{ t.chapters }}</dt>
        <dd>{{ chapters | size }}</dd>
      </div>
    </dl>

    <div class="course-description">
      {{ content }}
    </div>

    <hr class="section-rule">
    <p class="section-supertitle mono">{{ t.contents }}</p>

    <ol class="course-toc">
      {% for chapter in chapters %}
        <li class="course-toc-row">
          <span class="course-toc-num mono">{{ chapter.chapter | prepend: '00' | slice: -2, 2 }}</span>
          <a class="course-toc-title u-underline" href="{{ chapter.url | relative_url }}">{{ chapter.title }}</a>
        </li>
      {% endfor %}
    </ol>

    <p class="course-disclaimer mono">{{ t.disclaimer }}</p>
  </article>
</div>
