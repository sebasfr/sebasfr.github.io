---
layout: default
---
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post brutalist-page">
  <header class="post-header page-head">
    {% if page.drop_numeral %}
      <div class="drop-numeral anim-stamp" aria-hidden="true">{{ page.drop_numeral }}.</div>
    {% endif %}
    <div class="page-head-body">
      {% if page.rail_numeral %}
        <p class="page-head-supertitle anim-clip-reveal">{{ page.rail_numeral }} &mdash; {{ page.title | upcase }}</p>
      {% endif %}
      <h1 class="page-head-title anim-letter-mask">{{ page.title }}</h1>
      {% if page.description %}
        <p class="page-head-dek anim-fade-rise">{{ page.description }}</p>
      {% endif %}
    </div>
  </header>

  <article class="brutalist-article anim-content-sweep">
    {{ content }}
  </article>

  {% if page.related_publications %}
    <h2>References</h2>
    <div class="publications">
      {% bibliography --cited_in_order %}
    </div>
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
