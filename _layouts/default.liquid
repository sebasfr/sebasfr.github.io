<!doctype html>
<html lang="{{ site.lang }}">
  <!-- Head -->
  <head>
    {% if page.redirect %}
      {% if page.redirect == true %}
        {% assign redirect = site.baseurl | append: '/' %}
      {% elsif page.redirect contains '://' %}
        {% assign redirect = page.redirect %}
      {% else %}
        {% assign redirect = page.redirect | relative_url %}
      {% endif %}
      <meta http-equiv="refresh" content="3; url={{ redirect }}">
    {% endif %}
    {% include head.liquid %}
  </head>

  <!-- Body -->
  <body class="{% if page.url == '/' %}home {% endif %}{% if page.layout %}layout-{{ page.layout }} {% endif %}{% unless site.footer_fixed %}sticky-bottom-footer{% endunless %}">
    <!-- Site grid: left rail (>=900px) + content -->
    <div class="site-grid">
      {% include sidebar_rail.liquid %}

      <div class="site-content">
        <!-- Mobile header: wordmark + hamburger + (drawer lives in aside) -->
        {% include header.liquid %}
        {% include mobile_drawer.liquid %}

        <!-- Content -->
        <main class="container mt-5" role="main">
          {% if page.toc and page.toc.sidebar %}
            {% if page.toc.sidebar == 'right' %}
              <div class="row">
                <div class="col-sm-9">{{ content }}</div>
                <div class="col-sm-3">
                  <nav id="toc-sidebar" class="sticky-top"></nav>
                </div>
              </div>
            {% else %}
              <div class="row">
                <div class="col-sm-3">
                  <nav id="toc-sidebar" class="sticky-top"></nav>
                </div>
                <div class="col-sm-9">{{ content }}</div>
              </div>
            {% endif %}
          {% else %}
            {{ content }}
          {% endif %}
        </main>

        <!-- Footer -->
        {% include footer.liquid %}
      </div>
    </div>

    <!-- JavaScripts -->
    {% include scripts.liquid %}
  </body>
</html>
