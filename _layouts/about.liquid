---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="home-page">
  {%- comment -%} Hero: two variants, switched via page.hero_variant. {%- endcomment -%}
  {% if page.hero_variant == "masthead" %}
    {% include hero_masthead.liquid %}
  {% else %}
    {% include hero_wordmark.liquid %}
  {% endif %}

  <section class="home-bio">
    {% include bio.liquid %}
  </section>

  {% include flar_feature.liquid %}

  {% if page.selected_papers %}
    <section class="home-latest-research reveal-on-scroll">
      <hr class="section-rule">
      <div class="section-heading">
        <p class="section-supertitle">LATEST RESEARCH</p>
        <a class="section-link u-underline" href="{{ '/research/' | relative_url }}">→ all research</a>
      </div>
      <div class="research-body">{% include selected_papers.liquid %}</div>
    </section>
  {% endif %}

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-dispatches reveal-on-scroll">
      {% include dispatches.liquid %}
    </section>
  {% endif %}

  {% if page.latest_posts and page.latest_posts.enabled %}
    {%- assign course_homes = site.courses
      | where_exp: "c", "c.chapter == nil"
      | sort: "code" -%}
    {% if course_homes.size > 0 %}
      <section class="home-latest-notes reveal-on-scroll">
        <hr class="section-rule">
        <div class="section-heading">
          <p class="section-supertitle">RECENT NOTES</p>
          <a class="section-link u-underline" href="{{ '/notes/' | relative_url }}">→ all notes</a>
        </div>
        <ol class="home-notes-list">
          {% assign limit = page.latest_posts.limit | default: 3 %}
          {% for course in course_homes limit: limit %}
            <li class="home-note-item">
              <p class="home-note-date mono">{{ course.code | default: course.course | upcase }}</p>
              <div class="home-note-body">
                <h3 class="home-note-title">
                  <a class="u-underline" href="{{ course.url | relative_url }}">{{ course.title }}</a>
                </h3>
                {% if course.description %}
                  <p class="home-note-dek">{{ course.description | markdownify | strip_html | strip }}</p>
                {% endif %}
              </div>
            </li>
          {% endfor %}
        </ol>
      </section>
    {% endif %}
  {% endif %}

  {% if page.social %}
    <section class="home-social">
      <div class="contact-icons">{% include social.liquid %}</div>
    </section>
  {% endif %}
</div>
