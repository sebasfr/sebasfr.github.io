---
layout: default
---
{% if page._styles %}
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="home-page">
  {%- comment -%} Hero: two variants, switched via page.hero_variant. {%- endcomment -%}
  {% if page.hero_variant == "masthead" %}
    {% include hero_masthead.liquid %}
  {% else %}
    {% include hero_wordmark.liquid %}
  {% endif %}

  <section class="home-bio">
    {% include bio.liquid %}
  </section>

  {% include flar_feature.liquid %}

  {% if page.selected_papers %}
    <section class="home-latest-research reveal-on-scroll">
      <hr class="section-rule">
      <div class="section-heading">
        <p class="section-supertitle">LATEST RESEARCH</p>
        <a class="section-link u-underline" href="{{ '/research/' | relative_url }}">→ all research</a>
      </div>
      <div class="research-body">{% include selected_papers.liquid %}</div>
    </section>
  {% endif %}

  {% if page.announcements and page.announcements.enabled %}
    <section class="home-dispatches reveal-on-scroll">
      {% include dispatches.liquid %}
    </section>
  {% endif %}

  {% if page.latest_posts and page.latest_posts.enabled %}
    <section class="home-latest-notes reveal-on-scroll">
      <hr class="section-rule">
      <div class="section-heading">
        <p class="section-supertitle">LATEST NOTES</p>
        <a class="section-link u-underline" href="{{ '/notes/' | relative_url }}">→ all notes</a>
      </div>
      <ol class="home-notes-list">
        {% assign recent_posts = site.posts | slice: 0, 3 %}
        {% for post in recent_posts %}
          <li class="home-note-item">
            <p class="home-note-date mono">{{ post.date | date: "%Y.%m.%d" }}</p>
            <div class="home-note-body">
              <h3 class="home-note-title">
                <a class="u-underline" href="{{ post.url | relative_url }}">{{ post.title }}</a>
              </h3>
              {% if post.description %}
                <p class="home-note-dek">{{ post.description }}</p>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    </section>
  {% endif %}

  {% if page.social %}
    <section class="home-social">
      <div class="contact-icons">{% include social.liquid %}</div>
    </section>
  {% endif %}
</div>
