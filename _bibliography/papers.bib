@unpublished{GapMandateExec,
  title={The Gap Between Mandate and Execution: An Evaluation of the Inflation Target in Costa Rica},
  author={Fernández, Sebastián},
  year={2026},
  selected={true},
  note={Working Paper},
  pdf={The_Gap_beween_Mandate_and_Execution.pdf},
  preview={gap_policy_preview.png},
  abstract = {This paper addresses recent concerns about a possible contractionary bias in the policy execution of the Central Bank of Costa Rica (BCCR). I evaluate this hypothesis using three empirical approaches: a VAR estimation of long-run expectations following following Demertzis et al. (2008), a UCSV estimation of the long-run inflationary trend based on Chan et al. (2018), and a structural estimation of policy rule asymmetries following Surico (2007). The results show that expectations stabilize towards an anchor between 2.46-2.58\%, lower than the BCCR's 3\% mandate. The estimated inflationary trend shows systematic deviations from the target, with its 2023-2025 varying between 1.98-2.35\%. Finally, I find statistically significant evidence of an asymmetric policy rule, characterized by a more aggressive reaction to positive inflation deviations relative to negative ones.}
}

@unpublished{InflationTrend,
  title={Estimación de tendencia inflacionaria mediante componentes no observados},
  author={Fernández, Sebastián and Vargas, Alberth},
  year={2025},
  note={Working Paper. Draft and slides in Spanish.},
  pdf={trend_inflation.pdf},
  slides={Trend_inflation_slides.pdf},
  preview={trend_inflation_preview.png},
  abstract = {Este trabajo estima la tendencia inflacionaria de largo plazo en Costa Rica mediante un modelo bivariado de componentes no observados con volatilidad estocástica (Chan et al., 2018). Utilizando datos trimestrales anualizados del IPC, medidas de inflación subyacente y expectativas de mercado a 60 meses, se obtiene una medida del componente permanente de la inflación, su evolución temporal y coeficientes que varían en el tiempo. Los resultados sugieren que la tendencia inflacionaria se ha ubicado por debajo de la meta del Banco Central del 3\% en la mayoría de las especificaciones estimadas, para la especificación base, el promedio de la tendencia se ha ubicado en 2.1\% entre 2023 y 2025; es decir, se ha estabilizado por debajo de la meta y muy cerca del límite inferior del rango de tolerancia.}
}

@unpublished{SupplyShocks,
  title={Supply Shocks, Monetary Policy, and Foreign Investment: The Costa Rican Case},
  author={Fernández, Sebastián},
  year={2024},
  note={Working Paper. Slides in Spanish. <i>New draft soon!</i>},
  pdf={Suppy_Shocks.pdf},
  slides={Supply_Shocks_Slides.pdf},
  preview={supply_shocks_preview.png},
  abstract = {In this article, I examine the impact of global supply disruptions on Latin American economies. I focus on the Costa Rican case to show that foreign investment attraction strategies, nearshoring, and monetary policy jointly explain the country’s unusual displays of accelerated growth and deflation shortly after a supply shock. For such purposes, I combine an empirical analysis using aggregate macroeconomic data and a theoretical analysis to rationalize the macroeconomic behavior of a small and open economy with Costa Rica’s characteristics. The results indicate that the higher presence of multinational companies, triggered by foreign investment, casts beneficial effects over aggregate productivity, therefore mitigating the effects of supply shocks.}
}

